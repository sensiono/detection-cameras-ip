# Environnements — jamais versionnés. `.venv/` ne couvre PAS `.venv-train/` :
# un motif sans joker ne matche que le nom exact.
.venv/
.venv*/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
dist/
.angular/

# Secrets et fichiers déposés par les utilisateurs
backend/.env
backend/media/



# Data directories (keep directory structure, ignore media/images)
data/**
!data/
!data/**/
!data/**/.gitkeep


.DS_Store
*.pdf.tmp
*.egg-info/
.idea/
backend/.idea/


