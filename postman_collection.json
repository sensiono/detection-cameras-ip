{
  "info": {
    "name": "VISION AI - Backend API Collection",
    "_postman_id": "c1f7b820-94f2-4b2a-89a3-vision-ai-backend",
    "description": "Collection complète pour tester l'ensemble des endpoints du backend Django REST (Authentification, Ingestion IA, Présences, Véhicules, Alertes, Paramètres Entreprise, Rapports).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "camera_token",
      "value": "34782ab9b3e172ca2b9ddae66e3dfed658a68c87",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentification & Profil",
      "item": [
        {
          "name": "Login JWT (Obtenir le token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.access) {",
                  "    pm.collectionVariables.set('jwt_token', data.access);",
                  "    console.log('JWT Token set successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"adminpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            }
          }
        },
        {
          "name": "Qui suis-je ? (GET /api/auth/me/)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
